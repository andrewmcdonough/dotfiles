#!/usr/bin/env python3
"""Sort the tabs in each herdr workspace alphabetically by label.

Uses the socket API's tab.move, which the herdr CLI doesn't expose.
Pass --dry-run to print the new order without moving anything.
"""
import json
import os
import socket
import sys

SOCKET_PATH = os.path.expanduser("~/.config/herdr/herdr.sock")


def request(method, params):
    with socket.socket(socket.AF_UNIX) as sock:
        sock.connect(SOCKET_PATH)
        sock.sendall((json.dumps({"id": method, "method": method, "params": params}) + "\n").encode())
        buffer = b""
        while not buffer.endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            buffer += chunk
    response = json.loads(buffer)
    if "error" in response:
        sys.exit(f"{method} failed: {response['error']}")
    return response["result"]


dry_run = "--dry-run" in sys.argv
tabs = request("tab.list", {})["tabs"]

tabs_by_workspace = {}
for tab in tabs:
    tabs_by_workspace.setdefault(tab["workspace_id"], []).append(tab)

for workspace_id, workspace_tabs in tabs_by_workspace.items():
    sorted_tabs = sorted(workspace_tabs, key=lambda tab: tab["label"].lower())
    print(f"{workspace_id}: {', '.join(tab['label'] for tab in sorted_tabs)}")
    if dry_run:
        continue
    for insert_index, tab in enumerate(sorted_tabs):
        request("tab.move", {"tab_id": tab["tab_id"], "insert_index": insert_index})
